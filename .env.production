BE_BASEPATH="/explorer"
# HTTP JSON-RPC endpoint of the Besu node the explorer reads from
BE_RPC_URL=http://127.0.0.1:8545
# Optional: RPC URL given to the browser wallet, if browsers can't reach BE_RPC_URL
BE_PUBLIC_RPC_URL=
NODE_ENV=production

DISABLE_AUTH=false

# Public URL of the auth API, including BE_BASEPATH
NEXTAUTH_URL=http://localhost:25000/explorer/api/auth
NEXTAUTH_URL_INTERNAL=http://localhost:25000
NEXTAUTH_SECRET=
# To generate NEXTAUTH_SECRET: `openssl rand -hex 32` or go to https://generate-secret.now.sh/32

# Who may sign in with an OAuth provider: comma-separated, case-insensitive.
# OAuth sign-ins are denied unless the account's email matches one of these.
# Domains match exactly, so example.com doesn't admit sub.example.com.
BE_ALLOWED_DOMAINS=
BE_ALLOWED_EMAILS=

# Simple username/password sign-in for testing; not subject to the allow lists above
local_username=
local_password=

# Each OAuth provider is enabled when all of its variables are set. Register
# its callback URL with the provider: ${NEXTAUTH_URL}/callback/<provider>,
# for example http://localhost:25000/explorer/api/auth/callback/github.

# Callback URL: ${NEXTAUTH_URL}/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Callback URL: ${NEXTAUTH_URL}/callback/auth0
AUTH0_ID=
AUTH0_SECRET=
AUTH0_ISSUER=

# Callback URL: ${NEXTAUTH_URL}/callback/facebook
FACEBOOK_ID=
FACEBOOK_SECRET=

# Callback URL: ${NEXTAUTH_URL}/callback/google
GOOGLE_ID=
GOOGLE_SECRET=

# Callback URL: ${NEXTAUTH_URL}/callback/twitter
TWITTER_ID=
TWITTER_SECRET=

# Callback URL: ${NEXTAUTH_URL}/callback/gitlab
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# Callback URL: ${NEXTAUTH_URL}/callback/azure-ad
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Use your directory (tenant) ID, not "common", so only your organisation can sign in
AZURE_AD_TENANT_ID=

# Callback URL: ${NEXTAUTH_URL}/callback/atlassian
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Callback URL: ${NEXTAUTH_URL}/callback/cognito
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=

# Callback URL: ${NEXTAUTH_URL}/callback/okta
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_ISSUER=

# Callback URL: ${NEXTAUTH_URL}/callback/slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
