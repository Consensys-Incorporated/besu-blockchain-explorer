QE_BASEPATH="/explorer"
# HTTP JSON-RPC endpoint of the Besu node the explorer reads from
QE_RPC_URL=http://127.0.0.1:8545
# Optional: RPC URL given to the browser wallet, if browsers can't reach QE_RPC_URL
QE_PUBLIC_RPC_URL=
# Demo networks only, never production: validator RPC endpoints that enable voting
QE_VALIDATORS_CONFIG_PATH=
NODE_ENV=production

DISABLE_AUTH=false

# Public URL of the auth API, including QE_BASEPATH
NEXTAUTH_URL=http://localhost:25000/explorer/api/auth
NEXTAUTH_URL_INTERNAL=http://localhost:25000
NEXTAUTH_SECRET=
# To generate NEXTAUTH_SECRET: `openssl rand -hex 32` or go to https://generate-secret.now.sh/32

local_username=
local_password=

GITHUB_ID=
GITHUB_SECRET=

AUTH0_ID=
AUTH0_SECRET=
AUTH0_ISSUER=

FACEBOOK_ID=
FACEBOOK_SECRET=

GOOGLE_ID=
GOOGLE_SECRET=

TWITTER_ID=
TWITTER_SECRET=

GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=

OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_ISSUER=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
